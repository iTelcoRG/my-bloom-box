---
import PlaceholderImage from './PlaceholderImage.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="page-width hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">Celebrating every <em>first period.</em></h1>
      <p class="lead">Thoughtfully curated to help every girl feel confident, supported and celebrated through one of life's most important milestones.</p>
      <div class="hero-actions"><a class="button" href="#shop">Shop the Bloom Box <span aria-hidden="true">↗</span></a><a class="button button--secondary" href="#our-story">Our story</a></div>
    </div>
    <div class="hero-media">
      <PlaceholderImage kind="hero" label="Lifestyle image to come" eager />
      <div class="hero-card"><span aria-hidden="true">♡</span> Made for her,<br />with love.</div>
    </div>
  </div>
</section>
